legacy-peer-deps=true

# Private @foodhubglobal scope. The auth token is NOT stored here — it is read from
# the NPM_TOKEN environment variable at install time (npm/bun expand ${NPM_TOKEN}).
#   Devs: add `export NPM_TOKEN=<your npm token>` to your shell profile (~/.zshrc).
#   CI:   provide NPM_TOKEN as a secret env var.
@foodhubglobal:registry=https://registry.npmjs.org
//registry.npmjs.org/:_authToken=${NPM_TOKEN}