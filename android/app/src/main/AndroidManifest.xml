<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network access for webhook calls -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Draw over other apps — lets us show an incoming-call banner on the lock
      screen and over third-party apps. This is a special, user-granted
      permission (not part of the restricted Phone / Call Log groups) and is
      toggled manually by the user in system settings.
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!--
      Required on API 34+ to declare android:foregroundServiceType="phoneCall"
      on the CallScreeningService. On Android 16 (targetSdk 36) the system
      will not bind a CallScreeningService that lacks this type declaration.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_PHONE_CALL" />

    <!--
      Allows TelephonyCallback.CallStateListener to detect when a call ends so
      the incoming-call overlay can be dismissed. READ_BASIC_PHONE_STATE is a
      normal (auto-granted) permission introduced in API 33; on API 31-32 the
      callback registration is attempted but falls back to a 30-second timer.
    -->
    <uses-permission android:name="android.permission.READ_BASIC_PHONE_STATE" />

    <!--
      NOTE (Google Play "Permissions and APIs that Access Sensitive Information"
      compliance): This app does NOT request READ_CALL_LOG, READ_PHONE_STATE or
      READ_PHONE_NUMBERS. The incoming caller number is obtained from the
      CallScreeningService API (Call.Details.getHandle()), which requires the
      app to hold the user-granted call-screening role (RoleManager
      .ROLE_CALL_SCREENING). This is the supported "default handler capability"
      for caller-ID apps and needs no restricted Call Log / Phone permissions.
    -->

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:supportsRtl="true">

      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:theme="@style/LaunchTheme"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity>

      <!--
        Call-screening service. When the user grants this app the call-screening
        role, the system binds this service for every incoming call and delivers
        the caller number via Call.Details.getHandle() — with NO Call Log or
        Phone permissions. We allow the call through unchanged and use the number
        only to show the caller-ID banner and notify the takeaway webhook.

        BIND_SCREENING_SERVICE ensures only the OS Telecom framework can bind it.
      -->
      <service
        android:name=".CallScreeningServiceImpl"
        android:permission="android.permission.BIND_SCREENING_SERVICE"
        android:foregroundServiceType="phoneCall"
        android:exported="true">
        <intent-filter>
          <action android:name="android.telecom.CallScreeningService" />
        </intent-filter>
      </service>

      <!-- Floating overlay shown over the incoming-call screen. Requires SYSTEM_ALERT_WINDOW. -->
      <service
        android:name=".CallOverlayService"
        android:exported="false" />

    </application>
</manifest>
